        },
        {
            "name": "noya2 (Firebase Emulator - Android Emulator)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=USE_FIREBASE_EMULATOR=true",
                "--dart-define=FIREBASE_EMULATOR_HOST=10.0.2.2"
            ]
        },
        {
            "name": "noya2 (Firebase Emulator - phsysical device via USB)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=USE_FIREBASE_EMULATOR=true",
                "--dart-define=FIREBASE_EMULATOR_HOST=127.0.0.1"
            ]
        },
        {
            "name": "noya2 (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "noya2 (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
